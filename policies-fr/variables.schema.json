{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Variables des politiques FR",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "STORE_NAME",
    "LEGAL_NAME",
    "LEGAL_FORM",
    "REGISTER_ID",
    "REGISTER_CITY",
    "REGISTERED_ADDRESS",
    "SUPPORT_EMAIL",
    "WEBSITE_URL",
    "SELLING_COUNTRIES",
    "CURRENCY",
    "HANDLING_TIME",
    "TRANSIT_TIME",
    "TOTAL_DELIVERY_TIME",
    "WITHDRAWAL_DAYS",
    "RETURN_ADDRESS",
    "PRIVACY_CONTACT"
  ],
  "properties": {
    "STORE_NAME": {"type": "string", "minLength": 1},
    "LEGAL_NAME": {"type": "string", "minLength": 1},
    "LEGAL_FORM": {"type": "string", "minLength": 1},
    "SHARE_CAPITAL": {"type": "string"},
    "REGISTER_ID": {"type": "string", "description": "SIREN/SIRET ou identifiant applicable"},
    "REGISTER_CITY": {"type": "string"},
    "VAT_ID": {"type": "string"},
    "REGISTERED_ADDRESS": {"type": "string"},
    "RETURN_ADDRESS": {"type": "string"},
    "SUPPORT_EMAIL": {"type": "string", "format": "email"},
    "SUPPORT_PHONE": {"type": "string"},
    "SUPPORT_HOURS": {"type": "string"},
    "RESPONSE_TIME": {"type": "string"},
    "WEBSITE_URL": {"type": "string", "format": "uri"},
    "HOST_NAME": {"type": "string"},
    "HOST_ADDRESS": {"type": "string"},
    "HOST_PHONE": {"type": "string"},
    "PUBLICATION_DIRECTOR": {"type": "string"},
    "SELLING_COUNTRIES": {"type": "string"},
    "CURRENCY": {"type": "string", "default": "EUR"},
    "PRICES_INCLUDE_TAX": {"type": "string"},
    "PAYMENT_METHODS": {"type": "string"},
    "PAYMENT_PROVIDER": {"type": "string"},
    "ORDER_CUTOFF": {"type": "string"},
    "HANDLING_TIME": {"type": "string"},
    "TRANSIT_TIME": {"type": "string"},
    "TOTAL_DELIVERY_TIME": {"type": "string"},
    "BUSINESS_DAYS": {"type": "string"},
    "CARRIERS": {"type": "string"},
    "SHIPPING_PRICE_RULE": {"type": "string"},
    "TRACKING_URL": {"type": "string"},
    "WITHDRAWAL_DAYS": {"type": "integer", "minimum": 14},
    "COMMERCIAL_RETURN_DAYS": {"type": "integer", "minimum": 0},
    "RETURN_COST_CHANGE_OF_MIND": {"type": "string"},
    "RETURN_COST_DEFECT": {"type": "string"},
    "RETURN_METHOD": {"type": "string"},
    "NON_RETURNABLE_CATEGORIES": {"type": "string"},
    "REFUND_PROCESSING_INFO": {"type": "string"},
    "MEDIATOR_NAME": {"type": "string"},
    "MEDIATOR_ADDRESS": {"type": "string"},
    "MEDIATOR_URL": {"type": "string"},
    "PRIVACY_CONTACT": {"type": "string"},
    "DPO_CONTACT": {"type": "string"},
    "DATA_HOSTING_COUNTRIES": {"type": "string"},
    "DATA_PROCESSORS": {"type": "string"},
    "TRANSFER_SAFEGUARDS": {"type": "string"},
    "RETENTION_ORDER": {"type": "string"},
    "RETENTION_DELIVERY": {"type": "string"},
    "RETENTION_SUPPORT": {"type": "string"},
    "RETENTION_ACCOUNTING": {"type": "string"},
    "RETENTION_SECURITY": {"type": "string"},
    "RETENTION_MARKETING": {"type": "string"},
    "RETENTION_PROSPECT": {"type": "string"},
    "RETENTION_ANALYTICS": {"type": "string"},
    "RETENTION_ADS": {"type": "string"},
    "ESSENTIAL_COOKIES": {"type": "string"},
    "ESSENTIAL_DURATION": {"type": "string"},
    "PREFERENCE_COOKIES": {"type": "string"},
    "PREFERENCE_DURATION": {"type": "string"},
    "ANALYTICS_COOKIES": {"type": "string"},
    "ANALYTICS_DURATION": {"type": "string"},
    "ADS_COOKIES": {"type": "string"},
    "ADS_DURATION": {"type": "string"},
    "BILLING_PROCESS": {"type": "string"},
    "COOKIE_SETTINGS_URL": {"type": "string"},
    "PRIVACY_UPDATED_AT": {"type": "string"},
    "TERMS_UPDATED_AT": {"type": "string"}
  }
}
